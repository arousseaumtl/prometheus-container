{{ define "teams.card" }}
{
  "@context": "http://schema.org/extensions",
  "@type": "MessageCard",
  "title": "{{ .CommonLabels.alertname }} (x{{ len .Alerts }})",
  "summary": "{{ range .Alerts }}{{ .Annotations.description }} {{ end }}",
  "themeColor": "{{ if eq .Status "firing" }}FF0000{{ else }}00FF00{{ end }}",
  "sections": [
    {
      "markdown": true,
      "text": "{{ range $alert := .Alerts }}**Severity:** {{ $alert.Labels.severity }}<br>{{ if $alert.Labels.url }}**URL:** [{{ $alert.Labels.url }}]({{ $alert.Labels.url }})<br>{{ end }}**Description:** {{ $alert.Annotations.description }}<br><br>{{ end }}"
    }
  ]
}
{{ end }}
