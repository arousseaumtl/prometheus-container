{
  "id": null,
  "uid": "blackbox-dashboard",
  "title": "AMS Dashboard",
  "tags": ["blackbox"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "graph",
      "title": "URL Response",
      "targets": [
        {
          "expr": "probe_success",
          "interval": "",
          "legendFormat": "{{ url }}",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus",
      "yaxes": [
        {
          "format": "short",
          "label": "Status",
          "logBase": 1,
          "show": true,
          "min": 0,
          "max": 1
        }
      ],
      "xaxis": {
        "show": true
      },
      "lines": true,
      "linewidth": 1,
      "points": true,
      "pointradius": 2,
      "gridPos": {
        "h": 15,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "valueMappings": [
        {
          "id": 0,
          "op": "=",
          "text": "DOWN",
          "value": "0"
        },
        {
          "id": 1,
          "op": "=",
          "text": "UP",
          "value": "1"
        }
      ]
    },
    {
      "type": "graph",
      "title": "URL Latency",
      "targets": [
        {
          "expr": "probe_duration_seconds",
          "interval": "",
          "legendFormat": "{{ url }}",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus",
      "yaxes": [
        {
          "format": "s",
          "label": "Seconds",
          "logBase": 1,
          "show": true
        }
      ],
      "xaxis": {
        "show": true
      },
      "lines": true,
      "linewidth": 1,
      "points": true,
      "pointradius": 2,
      "gridPos": {
        "h": 15,
        "w": 24,
        "x": 0,
        "y": 15
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "datasource": "Prometheus",
        "refresh": 1,
        "name": "datasource",
        "label": "Data Source",
        "hide": 0
      }
    ]
  }
}
